project:
  name: elevator-ads-mvp
  repoPath: /mnt/c/elevator-ads-mvp
  defaultBranch: main

workItems:
  provider: github
  repo: caiohomem/elevator-ads-mvp
  readyLabel: agent-ready
  workingLabel: agent-working
  reviewLabel: agent-review
  pausedLabel: agent-paused
  blockedLabel: agent-blocked
  failedLabel: agent-failed

planner:
  provider: claude-cli
  command: claude
  # Optional: pin the Claude model. Use a non-1M-context model unless your
  # account has the corresponding usage credits enabled. Example: claude-sonnet-4-6.
  # model: claude-sonnet-4-6

executor:
  provider: codex-cli
  command: codex
  sandbox: workspace-write
  approval: never
  # To use opencode instead of codex, switch provider/command and set a model.
  # provider: opencode-cli
  # command: opencode
  # model: opencode/minimax-m3-free
  # (sandbox and approval are codex-only and ignored by opencode-cli.)

tests:
  commands:
    - dotnet test /mnt/c/elevator-ads-mvp/backend/ElevatorAds.sln
    - npm --prefix frontend/elevator-ads-admin run build

safety:
  maxFilesChanged: 25
  forbiddenPaths:
    - .env
    - .env.local
    - .env.production
    - appsettings.Production.json
    - secrets/
  # Opt-in: when true, Agent Foreman enables GitHub auto-merge on the PR
  # immediately after creation via `gh pr merge --auto`. GitHub will then
  # merge automatically once required checks and approvals (if any) are met.
  # Default false. Use with care — once enabled, every PR the agent opens
  # will be merged as soon as the repo allows.
  # autoMergeAfterChecks: false
  # autoMergeMethod: squash # one of: squash | merge | rebase

quota:
  retryAfterHours: 5
  quotaPatterns:
    - usage limit
    - rate limit
    - quota exceeded
    - try again later
    - limit reached
    - too many requests

database:
  provider: postgresql
  connectionString: Host=localhost;Port=5432;Database=agent_foreman;Username=agent_foreman;Password=agent_foreman
